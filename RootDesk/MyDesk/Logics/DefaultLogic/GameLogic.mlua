@Logic
script GameLogic extends Logic

	property string CurrentGameId = ""

	property string PlayMode = "SINGLE"

	property number CurrentScore = 0

	property number CurrentMaxTime = 60

	property integer MyPlayerId = 0

	property string OpponentPlayerId = ""

	property table MyRankingData = {}

	@ExecSpace("Server")
	method boolean SelectMinigame(string gameID, table userIds)
		
		-- 현재 플레이할 미니게임 ID를 선택한다.--
		if gameID == "" then log_warning("[_GameLogic] 미니게임 ID가 비어 있어 선택할 수 없습니다.")return false end
		
		-- 현재 Room 안에서 해당 미니게임 Map으로 이동 --
		local gameData = _MinigameRegistry:GetMinigameData(gameID)
		
		if #userIds == 0 then log_warning("[_GameLogic] 이동할 유저가 없습니다.")return false end
		
		-- 현재 플레이 중인 미니게임 갱신
		self.CurrentGameId = gameID
		
		-- 현재 InstanceRoom을 유지하면서
		-- 해당 미니게임 Map으로 이동
		local roomKey = _RoomService.RoomKey
		_RoomService:MoveUsersToInstanceRoom(roomKey, userIds, gameData.MapName)
		
		return true
		
	end

	@ExecSpace("Server")
	method boolean EnterMiniGameRoom(table gameIds, string roomKey, table userIds, string PlayMode)
		-- gameIds : 매치된 게임의 아이디들 , roomKey : 매칭키 , userIds:매칭한 두 사람 아이디들
		-- 매칭이 완료된 이후 1번, 솔플의 경우 맵 선택 이후 1번 호출-- 
		-- 게임 룸 최초 진입 시 호출--
		if #gameIds == 0 then log_warning("[_GameLogic] 입장할 미니게임이 없습니다.")return false end
		if roomKey == "" then log_warning("[_GameLogic] RoomKey가 비어 있습니다.")return false end
		if #userIds == 0 then log_warning("[_GameLogic] 입장할 유저가 없습니다.")return false end
		
		local mapNames = {}
		local code, memory = _RoomService:GetSharedMemory(roomKey)
		local result = memory:SetVariableAndWait("CurrentGameId",gameIds[1])
		
		
		--playMode도 보내야함--
		result = memory:SetVariableAndWait("PlayMode", PlayMode )
		
		-- 이번 Room에서 사용할 모든 미니게임 Map을 등록한다.
		for _, gameId in ipairs(gameIds) do
			---@type MinigameData
			local gameData = _MinigameRegistry:GetMinigameData(gameId)
			if gameData == nil then log_warning("[_GameLogic] 존재하지 않는 미니게임입니다. gameId : " .. gameId)return false end
			table.insert(mapNames, gameData.MapName)
		end
		
		-- InstanceRoom 생성
		local room = _RoomService:CreateInstanceRoom(roomKey, mapNames)
		if room == nil then log_warning("[_GameLogic] InstanceRoom 생성에 실패했습니다. RoomKey : " .. roomKey)return false end
		
		-- 최초진입만 EnterMiniGameRoom이 담당한다--
		room:MoveUsers(userIds,mapNames[1])
		
		return true
	end

	method void SetPlayMode(string playMode)
		-- 허용된 SINGLE 또는 MULTI 플레이 모드로 변경한다.
		if playMode ~= "SINGLE" and playMode ~= "MULTI" then log_warning("[_GameLogic] 지원하지 않는 플레이 모드입니다: " .. playMode)return
		end
		
		self.PlayMode = playMode
		
		
	end

	method void SetCurrentScore(number score)
		-- 현재 점수를 전달받은 값으로 설정한다.
		self.CurrentScore = score
	end

	method void AddScore(number score)
		-- 현재 점수에 전달받은 점수를 더한다.
		self.CurrentScore = self.CurrentScore + score
	end

	method void ResetScore()
		-- 현재 점수를 0으로 초기화한다.
		self.CurrentScore = 0
	end

	method void SetCurrentMaxTime(number maxTime)
		-- 현재 미니게임의 최대 제한시간을 변경한다.
		if maxTime <= 0 then
			log_warning("[_GameLogic] 최대 제한시간은 0보다 커야 합니다.")
			return
		end
		
		self.CurrentMaxTime = maxTime
	end

	method void SetOpponentPlayer(string playerId)
		-- 멀티플레이 상대 플레이어의 ID를 설정한다.
		if playerId == "" then
			log_warning("[_GameLogic] 상대 플레이어 ID가 비어 있어 설정할 수 없습니다.")
			return
		end
		
		self.OpponentPlayerId = playerId
	end

	method void ClearOpponentPlayer()
		-- 저장된 상대 플레이어 ID를 비운다.
		self.OpponentPlayerId = ""
	end

	@ExecSpace("Client")
	method void StartGamePlay(string gameId)
		-- 현재 선택된 미니게임의 시작을 로컬 실행 매니저에 요청한다.
		if gameId == "" then
			log_warning("[_GameLogic] 시작할 미니게임 ID가 비어 있습니다.")
			return
		end
		
		self.CurrentGameId = gameId
		-- 인트로의 START 이미지 출력이 끝난 뒤 실제 미니게임을 수행한다.
		local result = _MinigameManager:StartGame(gameId)
		
		if result == false then
			log_warning("[_GameLogic] 미니게임 시작에 실패했습니다. gameId: " .. gameId)
		end
	end

	method void EndMinigame()
		-- 현재 미니게임의 종료 처리를 로컬 실행 매니저에 위임한다.
		_MinigameManager:EndGame()
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 로컬 미니게임을 갱신하고 제한 시간에 도달하면 종료한다.
		_MinigameManager:Update(delta)
		if _MinigameManager.IsPlaying == false then
			return
		end
		
		if _MinigameManager.CurrentTime >= self.CurrentMaxTime then
			self:EndMinigame()
		end
	end

	@ExecSpace("Server")
	method string MakeSoloRoomKey(string userId)
		 local roomKey ="Solo_" ..userId .."_" ..tostring(DateTime.UtcNow.Elapsed)
		  return roomKey
	end

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		--싱글 룸에 들어가면 각 로직의 beginplay가 한번씩 더 불리므로, 싱글룸에 들어가서도 페이드인아웃이 적용되도록 설정
		_ScreenTransitionService:SetFadeInOutEnable(true)
	end

	@ExecSpace("ClientOnly")
	method void PlayIntro(string gameID)
		-- UI 접근과 이벤트 순서 제어는 전용 인트로 Logic에 위임한다.
		local result = _MinigameIntroLogic:BeginIntro(gameID)
		if result == false then
			log_warning("[_GameLogic] 미니게임 인트로 시작에 실패했습니다. gameId: " .. gameID)
		end
	end

	method string Make_InstanceRoomKey(table userIds)
		local strKey = ""
			
		for strID in pairs(userIds) do
			strKey = strKey .. strID
		end
		
		return strKey 
	end

	@ExecSpace("Client")
	method void Get_PlayMode()
		
	end

	@EventSender("Service", "RoomService")
	handler HandleRoomBeginEvent(RoomBeginEvent event)
		
		--------------- Native Event Sender Info ----------------
		-- Sender: RoomService
		-- Space: Server
		---------------------------------------------------------
		--룸 첫 진입 시 룸 안 영역에서 GameLogic의 변수를 업데이트한다--
		local roomKey = _RoomService.RoomKey
		
		local code, memory = _RoomService:GetSharedMemory(roomKey)
		
		if code ~= SharedMemoryResultCode.OK then return end
		
		local result = memory:GetVariableAndWait("CurrentGameId")
		
		if result.Code ~= SharedMemoryResultCode.OK then return end
		
		self.CurrentGameId = result.Info.Value
		log(self.CurrentGameId)
		
		--PlayMode도 연결--
		result = memory:GetVariableAndWait("PlayMode")
		if result.Code ~= SharedMemoryResultCode.OK then return end
		self.PlayMode=result.Info.Value 
		log(self.PlayMode)
		
		--최초진입시에만 fadescreen을 건든다.--
		--_MyUILogic:SetBlack()
		
	end

end