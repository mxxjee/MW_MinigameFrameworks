@Logic
script GameLogic extends Logic

	property string CurrentGameId = ""

	property string PlayMode = "NONE"

	property number CurrentScore = 0

	property number CurrentMaxTime = 60

	property integer MyPlayerId = 0

	property string OpponentPlayerId = ""

	property table MyRankingData = {}

	property integer introReadyCnt = 0

	property integer GameReadyCnt = 0

	property integer EndUIFinishedCnt = 0

	property integer GameEndTimerId = 0

	property number ReserveServerTime = 0

	property number GameEndServerTime = 0

	property number RemainingTime = 0

	property number LastDisplayedRemainingTime = -1

	property boolean IsReservedGamePlay = false

	property boolean IsGameEnding = false

	property boolean IsFinishGameProcessed = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		--싱글 룸에 들어가면 각 로직의 beginplay가 한번씩 더 불리므로, 싱글룸에 들어가서도 페이드인아웃이 적용되도록 설정
		_ScreenTransitionService:SetFadeInOutEnable(true)
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		local serverTime = _UtilLogic.ServerElapsedSeconds
		
		-- 모든 클라이언트가 전달받은 공통 서버 시각에 미니게임을 시작한다.
		if self.IsReservedGamePlay == true and serverTime >= self.ReserveServerTime then
			local startServerTime = self.ReserveServerTime
			self.IsReservedGamePlay = false
			self:StartGamePlay(self.CurrentGameId, startServerTime)
		end
		
		if _MinigameManager.IsPlaying == false then
			return
		end
		
		-- CurrentMaxTime을 직접 감소시키지 않고 공통 종료 서버 시각으로 남은 시간을 계산한다.
		self.RemainingTime = self.GameEndServerTime - serverTime
		if self.RemainingTime <= 0 then
			self.RemainingTime = 0
			return
		end
		
		local displayedRemainingTime = math.ceil(self.RemainingTime)
		if displayedRemainingTime ~= self.LastDisplayedRemainingTime then
			self.LastDisplayedRemainingTime = displayedRemainingTime
			_UIToast:ShowRemainingTime(displayedRemainingTime)
		end
		
		-- 실제 프레임 갱신 시간도 공통 시작 서버 시각을 기준으로 계산한다.
		_MinigameManager:Update(delta)
	end

	@ExecSpace("Server")
	method boolean SelectMinigame(string gameID, table userIds)
		self:Reset_Values_Server()
		
		-- 현재 플레이할 미니게임 ID를 선택한다.--
		if gameID == "" then log_warning("[_GameLogic] 미니게임 ID가 비어 있어 선택할 수 없습니다.")return false end
		
		-- 현재 Room 안에서 해당 미니게임 Map으로 이동 --
		local gameData = _MinigameRegistry:GetMinigameData(gameID)
		
		if #userIds == 0 then log_warning("[_GameLogic] 이동할 유저가 없습니다.")return false end
		
		-- 현재 플레이 중인 미니게임 갱신
		self.CurrentGameId = gameID
		
		-- 현재 InstanceRoom을 유지하면서
		-- 해당 미니게임 Map으로 이동
		local roomKey = _RoomService.RoomKey
		_RoomService:MoveUsersToInstanceRoom(roomKey, userIds, gameData.MapName)
		
		return true
		
	end

	@ExecSpace("Server")
	method boolean EnterMiniGameRoom(table gameIds, string roomKey, table userIds, string PlayMode)
		self:Reset_Values_Server()
		
		-- gameIds : 매치된 게임의 아이디들 , roomKey : 매칭키 , userIds:매칭한 두 사람 아이디들
		-- 매칭이 완료된 이후 1번, 솔플의 경우 맵 선택 이후 1번 호출-- 
		-- 게임 룸 최초 진입 시 호출--
		if #gameIds == 0 then log_warning("[_GameLogic] 입장할 미니게임이 없습니다.")return false end
		if roomKey == "" then log_warning("[_GameLogic] RoomKey가 비어 있습니다.")return false end
		if #userIds == 0 then log_warning("[_GameLogic] 입장할 유저가 없습니다.")return false end
		
		local mapNames = {}
		local code, memory = _RoomService:GetSharedMemory(roomKey)
		local result = memory:SetVariableAndWait("CurrentGameId",gameIds[1])
		
		
		--playMode도 보내야함--
		result = memory:SetVariableAndWait("PlayMode", PlayMode )
		
		-- 이번 Room에서 사용할 모든 미니게임 Map을 등록한다.
		for _, gameId in ipairs(gameIds) do
			---@type MinigameData
			local gameData = _MinigameRegistry:GetMinigameData(gameId)
			if gameData == nil then log_warning("[_GameLogic] 존재하지 않는 미니게임입니다. gameId : " .. gameId)return false end
			table.insert(mapNames, gameData.MapName)
		end
		
		-- InstanceRoom 생성
		local room = _RoomService:CreateInstanceRoom(roomKey, mapNames)
		if room == nil then log_warning("[_GameLogic] InstanceRoom 생성에 실패했습니다. RoomKey : " .. roomKey)return false end
		
		-- 최초진입만 EnterMiniGameRoom이 담당한다--
		room:MoveUsers(userIds,mapNames[1])
		
		return true
	end

	@ExecSpace("Client")
	method void Request_ReadyIntro()
		self:SendEvent(MinigameIntroReadyEvent())
	end

	@ExecSpace("Client")
	method void PlayIntro(string gameID)
		-- UI 접근과 이벤트 순서 제어는 전용 인트로 Logic에 위임한다.
		local result = _MinigameIntroLogic:BeginIntro(gameID)
		if result == false then
			log_warning("[_GameLogic] 미니게임 인트로 시작에 실패했습니다. gameId: " .. gameID)
		end
	end

	@ExecSpace("Client")
	method void StartGamePlay(string gameId, number startServerTime)
		-- 현재 선택된 미니게임의 시작을 로컬 실행 매니저에 요청한다.
		if gameId == "" then
			log_warning("[_GameLogic] 시작할 미니게임 ID가 비어 있습니다.")
			return
		end
		
		self.CurrentGameId = gameId
		-- 인트로의 START 이미지 출력이 끝난 뒤 실제 미니게임을 수행한다.
		local result = _MinigameManager:StartGame(gameId, startServerTime)
		
		if result == false then
			log_warning("[_GameLogic] 미니게임 시작에 실패했습니다. gameId: " .. gameId)
		end
	end

	method void SetCurrentScore(number score)
		-- 현재 점수를 전달받은 값으로 설정한다.
		self.CurrentScore = score
	end

	method void AddScore(number score)
		-- 현재 점수에 전달받은 점수를 더한다.
		self.CurrentScore = self.CurrentScore + score
	end

	method void ResetScore()
		-- 현재 점수를 0으로 초기화한다.
		self.CurrentScore = 0
	end

	method void SetCurrentMaxTime(number maxTime)
		-- 현재 미니게임의 최대 제한시간을 변경한다.
		if maxTime <= 0 then
			log_warning("[_GameLogic] 최대 제한시간은 0보다 커야 합니다.")
			return
		end
		
		self.CurrentMaxTime = maxTime
	end

	method void SetOpponentPlayer(string playerId)
		-- 멀티플레이 상대 플레이어의 ID를 설정한다.
		if playerId == "" then
			log_warning("[_GameLogic] 상대 플레이어 ID가 비어 있어 설정할 수 없습니다.")
			return
		end
		
		self.OpponentPlayerId = playerId
	end

	method void ClearOpponentPlayer()
		-- 저장된 상대 플레이어 ID를 비운다.
		self.OpponentPlayerId = ""
	end

	method void EndMinigame()
		-- 현재 미니게임의 종료 처리를 로컬 실행 매니저에 위임한다.
		_MinigameManager:EndGame()
		self.IsReservedGamePlay = false
		_UIToast:HideRemainingTime()
		self.RemainingTime = 0
		self.LastDisplayedRemainingTime = -1
		self.GameEndServerTime = 0
		self.ReserveServerTime = 0
	end

	@ExecSpace("ClientOnly")
	method void BeginGameEnd_Client()
		if self.IsGameEnding == true then
			return
		end
		
		self.IsGameEnding = true
		self:EndMinigame()
		
		if _MinigameEndLogic:BeginEndUI() == false then
			log_warning("[_GameLogic] Finish UI 시작에 실패했습니다.")
		end
	end

	@ExecSpace("ServerOnly")
	method void FinishGame_Server()
		if self.IsFinishGameProcessed == true then
			return
		end
		
		self.IsFinishGameProcessed = true
		
		-- 서버를 게임 종료의 단일 진입점으로 사용한다.
		-- 미니게임별 서버 종료 처리는 ServerManager에 위임하고,
		-- 이후 같은 종료 명령을 각 Client에 전달한다.
		_MinigameServerManager:EndCurrentGame_Server()
		self:FinishGame_Client()
		
		-- 라운드 승패와 점수 확정은 이 위치에 추후 추가한다.
		log("[_GameLogic] 서버 게임 종료 처리가 완료되었습니다.")
	end

	@ExecSpace("Client")
	method void FinishGame_Client()
		-- 서버에서 전달받은 종료 명령으로 로컬 게임과 종료 UI를 정리한다.
		-- Client OnUpdate의 종료 시각 검사와 동시에 호출되어도
		-- BeginGameEnd_Client의 IsGameEnding 검사가 중복 처리를 막는다.
		self:BeginGameEnd_Client()
	end

	@ExecSpace("Server")
	method string MakeSoloRoomKey(string userId)
		 local roomKey ="Solo_" ..userId .."_" ..tostring(DateTime.UtcNow.Elapsed)
		  return roomKey
	end

	method string Make_InstanceRoomKey(table userIds)
		local strKey = ""
			
		for i,strID in ipairs(userIds) do
			strKey = strKey .. strID
		end
		
		return strKey 
	end

	@ExecSpace("Client")
	method void Set_PlayMode(string playMode)
		-- 허용된 SINGLE 또는 MULTI 플레이 모드로 변경한다.
		if playMode ~= "SINGLE" and playMode ~= "MULTI" then log_warning("[_GameLogic] 지원하지 않는 플레이 모드입니다: " .. playMode)return
		end
		
		self.PlayMode = playMode
		
		
	end

	@ExecSpace("Server")
	method void Reset_Values_Server()
		if self.GameEndTimerId ~= 0 then
			_TimerService:ClearTimer(self.GameEndTimerId)
			self.GameEndTimerId = 0
		end
		
		self.introReadyCnt=0
		self.GameReadyCnt=0
		self.EndUIFinishedCnt=0
		self.IsFinishGameProcessed=false
	end

	@ExecSpace("Server")
	method void ReportIntroReady_Server()
		
		if self.PlayMode=="NONE" then return end
		
		--레디 개수 증가--
		self.introReadyCnt+=1
		
		local MaxCnt=0
		if self.PlayMode=="SINGLE" then
			MaxCnt=1
		else
			MaxCnt=2
		end
		
		if(self.introReadyCnt==MaxCnt) then
			-- 미니게임 서버 매니저에게도 데이터를 옮겨준다 --
			local isPrepared = _MinigameServerManager:PrepareGame_Server(self.CurrentGameId)
			if isPrepared == false then
				log_warning("[_GameLogic] 서버 미니게임 준비에 실패했습니다. gameId: " .. self.CurrentGameId)
				return
			end
		
			self:PlayIntro(self.CurrentGameId)
			log(self.PlayMode.."에서 인트로를 실행합니다.")
		end 
		
	end

	@ExecSpace("Server")
	method void ReportGameReady_Server()
		--각 클라이언트의 카운트다운 UI가 끝나면 각 클라이언트에서 게임준비됐어 신호를 보내는 함수 --
		
		if self.CurrentGameId ~= self.CurrentGameId then return end
		if self.PlayMode=="NONE" then return end
		
		--레디 개수 증가--
		self.GameReadyCnt+=1
		
		local MaxCnt=0
		if self.PlayMode=="SINGLE" then
			MaxCnt=1
		else
			MaxCnt=2
		end
		
		if(self.GameReadyCnt==MaxCnt) then
			---@type MinigameData
			local gameData = _MinigameRegistry:GetMinigameData(self.CurrentGameId)
			if gameData == nil then
				log_warning("[_GameLogic] 제한시간을 가져올 미니게임 데이터가 없습니다. gameId: " .. self.CurrentGameId)
				return
			end
		
			if gameData.MaxTime <= 0 then
				log_warning("[_GameLogic] 미니게임 제한시간은 0보다 커야 합니다. gameId: " .. self.CurrentGameId)
				return
			end
		
			self.CurrentMaxTime = gameData.MaxTime
		
			local startServerTime = _UtilLogic.ServerElapsedSeconds + 0.5
			local endServerTime = startServerTime + self.CurrentMaxTime
		
			-- 미니게임 서버 용 데이터를 Initialize() 한다 --
			local isServerInitialized = _MinigameServerManager:InitializeCurrentGame_Server(
				self.CurrentGameId,
				startServerTime,
				endServerTime
			)
			
			-- 서버용 데이터가 Initialize()되면 실제 게임을 Initialize()한다 -- 
			if isServerInitialized == false then
				log_warning("[_GameLogic] 서버 미니게임 초기화에 실패했습니다. gameId: " .. self.CurrentGameId)
				return
			end
		
			self:ReserveGameStart_Client(startServerTime, endServerTime, self.CurrentMaxTime)
		
			local endDelay = endServerTime - _UtilLogic.ServerElapsedSeconds
			
			-- 서버 시간이 끝나면, 동작 예약--
			self.GameEndTimerId = _TimerService:SetTimerOnce(function()
				self.GameEndTimerId = 0
				self:FinishGame_Server()
			end, endDelay)
		
			log(self.PlayMode.."에서 게임을 실행합니다.")
		end
	end

	@ExecSpace("Client")
	method void ReserveGameStart_Client(number startServerTime, number endServerTime, number maxTime)
		_MinigameEndLogic:ResetEndUI()
		self.ReserveServerTime = startServerTime
		self.GameEndServerTime = endServerTime
		self.CurrentMaxTime = maxTime
		self.RemainingTime = maxTime
		self.LastDisplayedRemainingTime = -1
		self.IsReservedGamePlay = true
		self.IsGameEnding = false
	end

	@ExecSpace("Server")
	method void ReportEndUIFinished_Server()
		self.EndUIFinishedCnt += 1
		
		local requiredCnt = 1
		if self.PlayMode == "MULTI" then
			requiredCnt = 2
		end
		
		if self.EndUIFinishedCnt == requiredCnt then
			self:ResolveNextGame_Server()
		end
	end

	@ExecSpace("ServerOnly")
	method void ResolveNextGame_Server()
		if self.PlayMode == "SINGLE" then
			self:ResolveSingleNextGame_Server()
			return
		end
		
		if self.PlayMode == "MULTI" then
			self:ResolveMultiNextGame_Server()
		end
	end

	@ExecSpace("ServerOnly")
	method void ResolveSingleNextGame_Server()
		-- SINGLE의 다음 게임 진행 여부와 이동 대상은 이 위치에서 판정한다.
		log("[_GameLogic] SINGLE 다음 게임 판정 대기")
	end

	@ExecSpace("ServerOnly")
	method void ResolveMultiNextGame_Server()
		-- MULTI의 라운드 결과와 다음 게임/최종 결과 이동 여부는 이 위치에서 판정한다.
		log("[_GameLogic] MULTI 다음 게임 판정 대기")
	end

	@ExecSpace("ServerOnly")
	method boolean MoveRoomUsersToScene_Server(string nextMapName, table userIds)
		if nextMapName == "" then
			log_warning("[_GameLogic] 이동할 다음 Scene 이름이 비어 있습니다.")
			return false
		end
		
		if #userIds == 0 then
			log_warning("[_GameLogic] 다음 Scene으로 이동할 사용자가 없습니다.")
			return false
		end
		
		local roomKey = _RoomService.RoomKey
		if roomKey == "" then
			log_warning("[_GameLogic] 현재 Instance Room Key가 없습니다.")
			return false
		end
		
		_RoomService:MoveUsersToInstanceRoom(roomKey, userIds, nextMapName)
		return true
	end

	@EventSender("Service", "RoomService")
	handler HandleRoomBeginEvent(RoomBeginEvent event)
		
		--------------- Native Event Sender Info ----------------
		-- Sender: RoomService
		-- Space: Server
		---------------------------------------------------------
		--룸 첫 진입 시 룸 안 영역에서 GameLogic의 변수를 업데이트한다 (동기화 작업)--
		local roomKey = _RoomService.RoomKey
		local code, memory = _RoomService:GetSharedMemory(roomKey)
		if code ~= SharedMemoryResultCode.OK then return end
		
		local result = memory:GetVariableAndWait("CurrentGameId")
		if result.Code ~= SharedMemoryResultCode.OK then return end
		self.CurrentGameId = result.Info.Value
		--log(self.CurrentGameId)
		
		--PlayMode도 연결--
		result = memory:GetVariableAndWait("PlayMode")
		if result.Code ~= SharedMemoryResultCode.OK then return end
		self.PlayMode=result.Info.Value 
		
		--PlayMode client에도 연결--
		self:Set_PlayMode(self.PlayMode)
		
		--동기화 이후 최초 진입하여 게임 시작 알리기--
		self:Request_ReadyIntro()
		
		
	end

	@EventSender("Self")
	handler HandleMinigameIntroReadyEvent(MinigameIntroReadyEvent event)
		-- space : Client --
		-- 미니게임 데이터가 다 연동되었는지 체크한다 -- 
		-- 1. 플레이모드 연동체크--
		if (self.PlayMode=="NONE") then return end
		
		-- 2. 플레이 모드에 따른 분기 -- 
		-- 인트로 재생 : 레디 확인받고 시작 (동시시작)
		-- 서버 영역에 나 레디됐음 보내기 --
		if _GameLogic.PlayMode == "SINGLE" then
			if self.CurrentGameId~="" then
			self:ReportIntroReady_Server()
				
			--_GameLogic:PlayIntro(self.CurrentGameId)
			end
		elseif _GameLogic.PlayMode=="MULTI" then
			if self.CurrentGameId~="" then
			self:ReportIntroReady_Server()
			
			
			end
		end
	end

end