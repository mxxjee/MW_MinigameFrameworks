@Logic
script GameLogic extends Logic

	property integer PlayMode = 0

	method void SetPlayMode(integer playMode)
		if playMode ~= _GameEnum.PlayMode.SINGLE and playMode ~= _GameEnum.PlayMode.MULTI then
			log_warning("[_GameLogic] 지원하지 않는 플레이 모드입니다: " .. playMode)
			return
		end
		
		self.PlayMode = playMode
	end

end
