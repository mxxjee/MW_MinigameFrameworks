@Logic
script GameEnum extends Logic

	property table PlayMode = {}

	property table FadeState = {}

	property table MatchState = {
		WAITING = 0,
		ACTIVE = 1,
		COUNTDOWN = 2,
		PLAYING = 3,
		FINISH = 4
	}

	property table EndType = {}

	method void OnBeginPlay()
		self.PlayMode = enum({
			SINGLE = 0,
			MULTI = 1})
		
		
		--페이드인 상태
		self.FadeState = enum({
			NONE = 0,
			FADE_OUT = 1,
			BLACK = 2,
			FADE_IN = 3})
		
		--게임 종료 타입
		self.EndType = enum({
			NONE = 0,
			TIME_ONLY = 1,
			TARGET_ONLY = 2})
		
	end

end