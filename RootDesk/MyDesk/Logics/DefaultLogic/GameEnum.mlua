@Logic
script GameEnum extends Logic

	property table PlayMode = {}

	property table FadeState = {}

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self.PlayMode = enum({
		SINGLE=0,
		MULTI=1})
		
		--페이드인 상태
		self.FadeState=enum({
		NONE=0,
		FADE_OUT=1,
		BLACK=2,
		FADE_IN=3})
	end

end