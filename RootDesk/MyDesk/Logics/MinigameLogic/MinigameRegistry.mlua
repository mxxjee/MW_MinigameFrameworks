@Logic
script MinigameRegistry extends Logic

	property table MinigameDatas = {}

	property table MinigameOrders = {}

	property boolean bInitailized = false

	method void OnBeginPlay()
		
		
		self:Initialize()
		
		
	end

	method boolean RegisterMinigame(string name, string id, string _mapName, string desc)
		-- 검증 용
		if self:ValidateRegisterData(id) == false then return false end
		
		-- 검증 후 ) 데이터를 만들어 id값으로 데이터를 저장한다.
		
		---@type MinigameData
		local gameData = MinigameData()
		gameData:InitData(name, id, _mapName, desc)
		self.MinigameDatas[id] = gameData
		
		table.insert(self.MinigameOrders, id)
		return true
	end

	method boolean ValidateRegisterData(string id)
		-- 빈 ID, nil Component, 중복 ID를 검사한다.
		if id == "" then log_warning("[MinigameRegistry] ID가 비어있습니다.")return false end
		if self.MinigameDatas[id] ~= nil then log_warning("[MinigameRegistry] 이미 등록된 ID입니다. ID: " .. id)return false end
		
		
		return true
	end

	method MinigameData GetMinigameData(string id)
		-- 클라이언트 영역에 Registry데이터가없는 경우를 대비--
		if(#self.MinigameDatas==0) then self:Initialize() end
		
		
		-- ID를 Key로 MinigameData를 직접 조회한다.
		local gameData = self.MinigameDatas[id]
		
		if gameData == nil then return nil end
		
		return gameData
	end

	method void Initialize()
		--이미 초기화되었으면 또 등록 X --
		if (self.bInitailized) then return end
		
		-- 첫 진입 ) 에디터에 연결된 모든 미니게임을 중앙에서 등록한다.
		self:RegisterMinigame("버튼게임", "Button_Game", "ButtonGameScene", "버튼을 마구마구 눌러보세요!\n 연타연타!!")
		self:RegisterMinigame("민거니 먹빵", "GunHee_Muckbang", "TestScene", "오늘의 머빵은\n 민거니!")
		self:RegisterMinigame("민지꾸얌", "Minji_Game", "TestScene", "민지의 생일은\n 0821이다.")
		self:RegisterMinigame("쥬신뿌수기", "Jusin_Game", "TestScene", "쥬신을 뿌시자~")
		
		--초기화 여부 판단, SelectScene 에서 시작하는 경우 오류가있어서 이를 통해 판단하고자함 --
		self.bInitailized = true
	end

end