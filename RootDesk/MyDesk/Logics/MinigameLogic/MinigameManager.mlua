@Logic
script MinigameManager extends Logic

	property MinigameComponent CurrentGame = nil

	property table CurrentMatchInfo = nil

	property number CurrentTime = 0

	property boolean IsPlaying = false

	@ExecSpace("ClientOnly")
	method boolean StartPracticeGame(string gameId)
		local gameData = _MinigameRegistry:GetMinigameData(gameId)
		if gameData == nil then
			log_warning("[_MinigameManager] 등록되지 않은 미니게임 ID입니다: " .. gameId)
			return false
		end
		
		if self.CurrentGame == nil then
			log_warning("[_MinigameManager] 현재 연결된 미니게임 컴포넌트가 없습니다.")
			return false
		end
		
		self.CurrentMatchInfo = nil
		self.CurrentTime = 0
		self.IsPlaying = true
		self.CurrentGame:InitializePractice(gameData)
		
		return true
	end

	@ExecSpace("ClientOnly")
	method boolean StartMatchedGame(string gameId, any matchInfo)
		if matchInfo == nil then
			log_warning("[_MinigameManager] 매칭 정보가 없어 시작할 수 없습니다.")
			return false
		end
		
		local gameData = _MinigameRegistry:GetMinigameData(gameId)
		if gameData == nil then
			log_warning("[_MinigameManager] 등록되지 않은 미니게임 ID입니다: " .. gameId)
			return false
		end
		
		if self.CurrentGame == nil then
			log_warning("[_MinigameManager] 현재 연결된 미니게임 컴포넌트가 없습니다.")
			return false
		end
		
		self.CurrentMatchInfo = matchInfo
		self.CurrentTime = 0
		self.IsPlaying = true
		self.CurrentGame:InitializeMatched(gameData, matchInfo)
		
		return true
	end

	@ExecSpace("ClientOnly")
	method void Update(number deltaTime)
		if self.IsPlaying == false then
			return
		end
		
		if self.CurrentGame == nil then
			return
		end
		
		self.CurrentTime = self.CurrentTime + deltaTime
		self.CurrentGame:Update(deltaTime)
	end

	@ExecSpace("ClientOnly")
	method void EndGame()
		if self.CurrentGame ~= nil then
			self.CurrentGame:Release()
		end
		
		self.CurrentGame = nil
		self.CurrentMatchInfo = nil
		self.CurrentTime = 0
		self.IsPlaying = false
	end

end