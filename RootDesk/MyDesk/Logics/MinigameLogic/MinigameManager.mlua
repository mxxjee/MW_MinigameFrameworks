@Logic
script MinigameManager extends Logic

	property MinigameComponent CurrentGame = nil

	property number CurrentTime = 0

	property number GameStartServerTime = 0

	property boolean IsPlaying = false

	@ExecSpace("Client")
	method boolean StartGame(string gameId, number startServerTime)
		-- 등록된 미니게임을 조회해 로컬 실행 상태를 시작한다.
		
		---@type MinigameData
		local gameData = _MinigameRegistry:GetMinigameData(gameId)
		if gameData == nil then log_warning("[_MinigameManager] 등록되지 않은 미니게임 ID입니다: " .. gameId)return false end
		if self.CurrentGame == nil then log_warning("[_MinigameManager] 현재 미니게임 Component가 등록되지 않았습니다.")return false end
		
		self.GameStartServerTime = startServerTime
		self.CurrentTime = _UtilLogic.ServerElapsedSeconds - self.GameStartServerTime
		if self.CurrentTime < 0 then
			self.CurrentTime = 0
		end
		self.IsPlaying = true
		self.CurrentGame:Initialize(gameData)
		
		return true
	end

	@ExecSpace("ClientOnly")
	method void Update(number deltaTime)
		-- 실행 중인 미니게임의 시간과 프레임 갱신을 위임한다.
		if self.IsPlaying == false then
			return
		end
		
		
		if self.CurrentGame == nil then
			return
		end
		
		log("현재 미니게임:"..self.CurrentGame.MinigameID.."플레잉중..")
		
		local previousTime = self.CurrentTime
		local synchronizedTime = _UtilLogic.ServerElapsedSeconds - self.GameStartServerTime
		if synchronizedTime < 0 then
			synchronizedTime = 0
		end

		self.CurrentTime = synchronizedTime

		local synchronizedDelta = self.CurrentTime - previousTime
		if synchronizedDelta < 0 then
			synchronizedDelta = 0
		end

		self.CurrentGame:Update(synchronizedDelta)
	end

	@ExecSpace("ClientOnly")
	method void EndGame()
		-- 현재 미니게임을 해제하고 로컬 실행 상태를 초기화한다.
		if self.CurrentGame ~= nil then
			self.CurrentGame:Release()
		end
		
		self.CurrentGame = nil
		self.CurrentTime = 0
		self.GameStartServerTime = 0
		self.IsPlaying = false
		
	end

end
