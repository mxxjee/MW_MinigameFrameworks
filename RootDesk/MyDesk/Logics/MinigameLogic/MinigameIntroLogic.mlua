@Logic
script MinigameIntroLogic extends Logic

	property MinigameIntroUIComponent IntroUI = nil

	property string CurrentGameId = ""

	property string IntroState = "IDLE"

	@ExecSpace("ClientOnly")
	method boolean BeginIntro(string gameId)
		-- 서버의 시작 신호 또는 SINGLE 진입 흐름이 공통으로 사용하는 로컬 인트로 진입점입니다.
		if gameId == "" then
			log_warning("[_MinigameIntroLogic] 미니게임 ID가 비어 있어 인트로를 시작할 수 없습니다.")
			return false
		end
		
		-- 같은 시작 신호가 중복 도착해도 Timer와 게임 시작이 중복 실행되지 않도록 막습니다.
		if self.IntroState ~= "IDLE" then
			log_warning("[_MinigameIntroLogic] 이미 인트로가 진행 중입니다. gameId: " .. self.CurrentGameId)
			return false
		end
		
		---@type MinigameData
		local gameData = _MinigameRegistry:GetMinigameData(gameId)
		if gameData == nil then
			log_warning("[_MinigameIntroLogic] 등록되지 않은 미니게임입니다. gameId: " .. gameId)
			return false
		end
		
		local introEntity = _EntityService:GetEntityByPath("/ui/GameIntroGroup")
		if isvalid(introEntity) == false then
			log_warning("[_MinigameIntroLogic] GameIntroGroup UI를 찾을 수 없습니다.")
			return false
		end
		
		---@type MinigameIntroUIComponent
		local introUI = introEntity:GetComponent("script.MinigameIntroUIComponent")
		if isvalid(introUI) == false then
			log_warning("[_MinigameIntroLogic] MinigameIntroUIComponent를 찾을 수 없습니다.")
			return false
		end
		
		self.IntroUI = introUI
		self.CurrentGameId = gameId
		self.IntroState = "LOGO"
		
		_GameHelper:EnableUIGroup("/ui/GameIntroGroup", true)
		self.IntroUI:Reset()
		self.IntroUI:PlayLogo(gameData.LogoGUID)
		
		return true
	end

	@ExecSpace("ClientOnly")
	method void ResetIntro()
		if isvalid(self.IntroUI) then
			self.IntroUI:Reset()
		end
		
		_GameHelper:EnableUIGroup("/ui/GameIntroGroup", false)
		self.IntroUI = nil
		self.CurrentGameId = ""
		self.IntroState = "IDLE"
	end

	@EventSender("Entity", "8f88597a-523d-471b-a665-86636c31ff2e")
	handler HandleMinigameLogoEndEvent(MinigameLogoEndEvent event)
		-- 로고 Fade Out 완료 이벤트를 받은 뒤에만 카운트다운을 시작합니다.
		if self.IntroState ~= "LOGO" then
			return
		end
		
		if isvalid(self.IntroUI) == false then
			self:ResetIntro()
			return
		end
		
		self.IntroState = "COUNTDOWN"
		self.IntroUI:PlayCountdown()
	end

	@EventSender("Entity", "8f88597a-523d-471b-a665-86636c31ff2e")
	handler HandleMinigameCountdownEndEvent(MinigameCountdownEndEvent event)
		-- START 이미지 출력이 끝난 뒤 발생한 이벤트에서 실제 미니게임을 한 번만 시작합니다.
		if self.IntroState ~= "COUNTDOWN" then
			return
		end
		
		local gameId = self.CurrentGameId
		self.IntroState = "COMPLETED"
		_GameHelper:EnableUIGroup("/ui/GameIntroGroup", false)
		self.IntroUI = nil
		
		
		_GameLogic:ReportGameReady_Server()
		
		-- 다음 미니게임 인트로를 다시 시작할 수 있도록 완료 상태를 초기화합니다.
		self.IntroState = "IDLE"
	end

end