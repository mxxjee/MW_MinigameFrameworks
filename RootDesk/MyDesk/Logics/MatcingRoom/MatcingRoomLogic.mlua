@Component
script MatcingRoomLogic extends Component

	property string MatchingRoomSceneName = "MatchingRoomScene"

	@ExecSpace("ClientOnly")
	method void Initialize()
		self:RefreshMatchingRoomUI()
	end

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self:Initialize()
	end

	@ExecSpace("ClientOnly")
	method void RefreshMatchingRoomUI()
		local localPlayer = _UserService.LocalPlayer
		if isvalid(localPlayer) == false then
			return
		end
		
		if localPlayer.CurrentMapName == self.MatchingRoomSceneName then
			_GameHelper:EnableUIGroup("/ui/LobbyGroup", false)
			_GameHelper:EnableUIGroup("/ui/SelectGroup", false)
			_GameHelper:EnableUIGroup("/ui/SelectButtonGroup", false)
			_GameHelper:EnableUIGroup("/ui/WaitingRoomGroup", true)
			_GameHelper:EnableUIGroup("/ui/WaitingRoomMatchGroup", true)
		else
			_GameHelper:EnableUIGroup("/ui/MatcingRoomGroup", false)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		local localPlayer = _UserService.LocalPlayer
		if isvalid(localPlayer) == false then
			return
		end
		
		if localPlayer.CurrentMapName ~= self.MatchingRoomSceneName then
			return
		end
	end

end