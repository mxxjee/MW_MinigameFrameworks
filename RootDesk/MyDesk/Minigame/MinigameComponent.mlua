@Component
script MinigameComponent extends Component

	property string MinigameID = ""

	method void Initialize(MinigameData gameData)
		
	end

	method void Update(number deltaTime)
		
	end

	method void Release()
		
	end

	@ExecSpace("ServerOnly")
	method void EndServer()
		-- 모든 미니게임이 공통으로 사용할 서버 종료 인터페이스입니다.
		-- 구체적인 종료 처리는 각 미니게임 Component에서 구현합니다.
	end

	@ExecSpace("ServerOnly")
	method boolean PrepareServer(MinigameData gameData)
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean InitializeServer(number startServerTime, number endServerTime)
		if startServerTime <= 0 then
			log_warning("[DropGameComponent] 시작 서버 시각은 0보다 커야 합니다.")
			return false
		end
		
		if endServerTime <= startServerTime then
			log_warning("[DropGameComponent] 종료 서버 시각은 시작 서버 시각보다 커야 합니다.")
			return false
		end
		
		local currentServerTime = _UtilLogic.ServerElapsedSeconds
		if endServerTime <= currentServerTime then
			log_warning("[DropGameComponent] 종료 서버 시각이 이미 지났습니다.")
			return false
		end
		
		return true
	end

	@ExecSpace("Server")
	method void RegisterGame_Server()
		_MinigameServerManager:RegisterGame_Server(self)
	end

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		if self.MinigameID == "" then
			log_warning("[MinigameComponent] MinigameID가 비어 있어 게임을 등록할 수 없습니다.")
			return
		end
		
		-- 같은 Entity의 서버 Component를 Instance Room 서버 Manager에 등록합니다.
		self:RegisterGame_Server()
		
		-- 각 클라이언트가 자기 맵의 구체 미니게임 Component를 로컬 Manager에 등록합니다.
		
		-- Client 영역의 변수--
		_MinigameManager:PrePare_Minigame(self)
		_GameLogic.CurrentGameId = self.MinigameID
		
		-- 미니게임 인트로 준비완료 이벤트 발송 : 이 안에서 클라이언트 변수들이 다 동기화되었는지 체크하고, 
		-- SINLGE 인 경우 바로 게임시작을, MULTI인 경우 2인 레디를 서버에 보낸다 --
		_GameLogic:Request_ReadyIntro()
		
		
	end

end
