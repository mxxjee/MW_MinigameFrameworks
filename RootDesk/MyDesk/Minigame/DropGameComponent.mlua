@Component
script DropGameComponent extends MinigameComponent

	property boolean IsServerInitialized = false

	property boolean IsServerPlaying = false

	property number ServerStartTime = 0

	property number ServerEndTime = 0

	property integer ServerStartTimerId = 0

	@HideFromInspector
	property DropObstacleSpawnerComponent ObstacleSpawner = "b5a5ec91-06d7-4931-84c3-8b2dda49648c"

	method void Initialize(MinigameData gameData)
		
	end

	method void Update(number deltaTime)
		
	end

	method void Release()
		
	end

	@ExecSpace("ServerOnly")
	method boolean PrepareServer(MinigameData gameData)
		if gameData == nil then
			log_warning("[DropGameComponent] 서버 준비에 필요한 미니게임 데이터가 없습니다.")
			return false
		end
		
		if gameData.ID ~= self.MinigameID then
			log_warning("[DropGameComponent] 요청된 미니게임 ID가 Component와 다릅니다. gameId: " .. gameData.ID)
			return false
		end
		
		-- 실제 스폰 설정과 타이머는 같은 Entity의 전용 Spawner Component가 관리합니다.
		local spawner = self.Entity.DropObstacleSpawnerComponent
		if isvalid(spawner) == false then
			log_warning("[DropGameComponent] DropObstacleSpawnerComponent를 찾을 수 없습니다.")
			return false
		end
		
		self.ObstacleSpawner = spawner
		return self.ObstacleSpawner:PrepareSpawner_Server()
	end

	@ExecSpace("ServerOnly")
	method boolean InitializeServer(number startServerTime, number endServerTime)
		if (__base:InitializeServer(startServerTime,endServerTime)==false) then return false end
		
		
		local currentServerTime = _UtilLogic.ServerElapsedSeconds
		
		if self.ServerStartTimerId ~= 0 then
			_TimerService:ClearTimer(self.ServerStartTimerId)
			self.ServerStartTimerId = 0
		end
		
		self.IsServerInitialized = false
		self.IsServerPlaying = false
		self.ServerStartTime = startServerTime
		self.ServerEndTime = endServerTime
		
		local startDelay = startServerTime - currentServerTime
		self.IsServerInitialized = true
		
		-- 네트워크 처리지연 방지, 이미 시작 시각을 지났을 경우 바로 실행시킴 (예외처리)--
		if startDelay <= 0 then
			if self:BeginServerGame_Server() == false then
				self.IsServerInitialized = false
				return false
			end
		
			return true
		end
		
		-- 정상동작 ( 딜레이 이후 서버 세팅)
		self.ServerStartTimerId = _TimerService:SetTimerOnce(function()
			self.ServerStartTimerId = 0
			self:BeginServerGame_Server()
		end, startDelay)
		
		if self.ServerStartTimerId == 0 then
			self.IsServerInitialized = false
			log_warning("[DropGameComponent] 서버 게임 시작 타이머 등록에 실패했습니다.")
			return false
		end
		
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean BeginServerGame_Server()
		if self.IsServerInitialized == false then
			return false
		end
		
		if self.IsServerPlaying == true then
			return true
		end
		
		if _UtilLogic.ServerElapsedSeconds >= self.ServerEndTime then
			log_warning("[DropGameComponent] 서버 게임을 시작하기 전에 종료 서버 시각이 지났습니다.")
			return false
		end
		
		self.IsServerPlaying = true
		if self:StartObstacleSpawner_Server() == false then
			self.IsServerPlaying = false
			return false
		end
		
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean StartObstacleSpawner_Server()
		-- DropGameComponent는 게임 흐름만 담당하고 실제 Spawn은 Spawner에 위임합니다.
		if isvalid(self.ObstacleSpawner) == false then
			log_warning("[DropGameComponent] 준비된 장애물 Spawner가 없습니다.")
			return false
		end
		
		return self.ObstacleSpawner:StartSpawner_Server()
	end

	@ExecSpace("ServerOnly")
	method void EndServer()
		-- 서버 종료의 단일 경로에서 Spawner 반복 타이머를 함께 정리합니다.
		self.IsServerPlaying = false
		
		if self.ServerStartTimerId ~= 0 then
			_TimerService:ClearTimer(self.ServerStartTimerId)
			self.ServerStartTimerId = 0
		end
		
		if isvalid(self.ObstacleSpawner) then
			-- 반복 생성만 멈추는 것이 아니라 현재 남아 있는 장애물도 모두 제거합니다.
			self.ObstacleSpawner:EndSpawner_Server()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		__base:OnBeginPlay()
	end

end