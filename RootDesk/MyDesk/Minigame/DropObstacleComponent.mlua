@Component
script DropObstacleComponent extends Component

	@MinValue(0)
	property integer Value = 1

	property number DestroyY = -4.5

	@HideFromInspector
	property number FallSpeed = 0

	@HideFromInspector
	property Vector3 FallStartPosition = Vector3.zero

	@HideFromInspector
	property number FallStartServerTime = 0

	@HideFromInspector
	property boolean IsActive = false

	@HideFromInspector
	property boolean PositionProbeLogged = false

	@HideFromInspector
	property table HitPlayers = {}

	@ExecSpace("ServerOnly")
	method boolean Spawn(number fallSpeed)
		-- 스포너가 만든 Root의 시작 위치를 기록하고 서버 낙하를 시작합니다.
		if fallSpeed <= 0 then
			log_warning("[DropObstacleComponent] FallSpeed는 0보다 커야 합니다.")
			return false
		end
		
		local transform = self.Entity.TransformComponent
		local trigger = self.Entity.TriggerComponent
		local visual = self.Entity:GetChildByName("DropVisual")
		if isvalid(transform) == false or isvalid(trigger) == false or isvalid(visual) == false then
			log_warning("[DropObstacleComponent] Root Transform/Trigger 또는 DropVisual이 없습니다.")
			return false
		end
		
		if isvalid(visual.TransformComponent) == false then
			log_warning("[DropObstacleComponent] DropVisual TransformComponent가 없습니다.")
			return false
		end
		
		if transform.Position.y <= self.DestroyY then
			log_warning("[DropObstacleComponent] Spawn 위치가 DestroyY 이하입니다.")
			return false
		end
		
		self.FallSpeed = fallSpeed
		self.FallStartPosition = transform.Position
		self.FallStartServerTime = _UtilLogic.ServerElapsedSeconds
		self.IsActive = true
		self.PositionProbeLogged = false
		self.HitPlayers = {}
		trigger.Enable = true
		self.Entity:SetVisible(true)
		self.Entity:SetEnable(true)
		
		--log("[DropObstacleComponent] 서버 Root 낙하 시작. name=" .. self.Entity.Name
			--.. ", start=" .. tostring(transform.WorldPosition)
			--.. ", speed=" .. tostring(fallSpeed))
		return true
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- Body 없이 서버의 Root Position만 이동합니다. 자식 Visual/Root Trigger는 함께 따라옵니다.
		if self.IsActive == false then
			return
		end
		
		local transform = self.Entity.TransformComponent
		if isvalid(transform) == false then
			self:Cleanup_Server()
			return
		end
		
		local elapsed = math.max(0, _UtilLogic.ServerElapsedSeconds - self.FallStartServerTime)
		local startPosition = self.FallStartPosition
		local nextY = startPosition.y - (self.FallSpeed * elapsed)
		transform.Position = Vector3(startPosition.x, nextY, startPosition.z)
		
		if self.PositionProbeLogged == false and nextY <= -1.5 then
			self.PositionProbeLogged = true
			self:LogPositionProbe_Server()
		end
		
		if nextY < self.DestroyY then
			self:Cleanup_Server()
		end
	end

	@ExecSpace("ServerOnly")
	method void LogPositionProbe_Server()
		-- 플레이어 높이 부근에서 서버 Root/Visual/Trigger 상태를 한 번 기록합니다.
		local visual = self.Entity:GetChildByName("DropVisual")
		local rootPosition = self.Entity.TransformComponent.WorldPosition
		local visualPosition = isvalid(visual) and visual.TransformComponent.WorldPosition or Vector3.zero
		local trigger = self.Entity.TriggerComponent
		log("[DropObstacleProbe][SERVER] name=" .. self.Entity.Name
			.. ", root=" .. tostring(rootPosition)
			.. ", visual=" .. tostring(visualPosition)
			.. ", triggerEnable=" .. tostring(trigger.Enable)
			.. ", triggerOffset=" .. tostring(trigger.ColliderOffset))
		self:LogPositionProbe_Client(rootPosition)
	end

	@ExecSpace("Client")
	method void LogPositionProbe_Client(Vector3 serverRootPosition)
		-- 진단 로그만 출력하며 클라이언트의 어떤 위치도 변경하지 않습니다.
		local visual = self.Entity:GetChildByName("DropVisual")
		local rootPosition = self.Entity.TransformComponent.WorldPosition
		local visualPosition = isvalid(visual) and visual.TransformComponent.WorldPosition or Vector3.zero
		local trigger = self.Entity.TriggerComponent
		--log("[DropObstacleProbe][CLIENT] name=" .. self.Entity.Name
			--.. ", serverRoot=" .. tostring(serverRootPosition)
			--.. ", root=" .. tostring(rootPosition)
			--.. ", visual=" .. tostring(visualPosition)
			--.. ", triggerEnable=" .. tostring(trigger.Enable)
			--.. ", triggerOffset=" .. tostring(trigger.ColliderOffset))
	end

	@ExecSpace("ServerOnly")
	method void OnPlayerCollision_Server(Entity player)
		-- 같은 장애물에 같은 플레이어가 다시 닿아도 HIT는 한 번만 처리합니다.
		if self.IsActive == false or isvalid(player) == false
			or isvalid(player.PlayerComponent) == false then
			return
		end
		
		if self.HitPlayers[player.Id] == true then
			return
		end
		self.HitPlayers[player.Id] = true
		
		local stateComponent = player.StateComponent
		if isvalid(stateComponent) then
			local currentStateName = stateComponent.CurrentStateName
			-- 이미 HIT 중이면 중복 전환이 false를 반환하므로 실패로 취급하지 않습니다.
			if currentStateName ~= "HIT" and stateComponent:ChangeState("HIT") == false then
				log_warning("[DropObstacleComponent] 플레이어 HIT 상태 변경에 실패했습니다. currentState="
					.. tostring(currentStateName))
			end
		else
			log_warning("[DropObstacleComponent] 플레이어의 StateComponent가 없습니다.")
		end
		
		log("[DropObstacleComponent] 플레이어 충돌 처리. obstacle=" .. self.Entity.Name
			.. ", player=" .. player.Name
			.. ", root=" .. tostring(self.Entity.TransformComponent.WorldPosition))
		-- 충돌 직후 제거하지 않습니다. Trigger와 Visual은 DestroyY까지 Root와 함께 이동합니다.
	end

	@ExecSpace("ServerOnly")
	method void Cleanup_Server()
		-- 낙하 종료 또는 게임 종료 시 스포너가 호출합니다.
		self.IsActive = false
		local trigger = self.Entity.TriggerComponent
		if isvalid(trigger) then
			trigger.Enable = false
		end
		
		if isvalid(self.Entity) then
			self.Entity:SetEnable(false)
			self.Entity:Destroy()
		end
	end

	@EventSender("Self")
	handler HandleTriggerEnterEvent(TriggerEnterEvent event)
		-- 장애물 Root의 Trigger가 Player와 겹쳤을 때만 서버에서 HIT를 처리합니다.
		local triggerBodyEntity = event.TriggerBodyEntity
		if isvalid(triggerBodyEntity) == false then
			return
		end
		
		if isvalid(triggerBodyEntity.PlayerComponent) then
			self:OnPlayerCollision_Server(triggerBodyEntity)
		end
	end

end
