@Component
script DropObstacleComponent extends Component

	@MinValue(0)
	property integer Value = 1

	@MinValue(0)
	property number SyncLeadTime = 0.2

	@MinValue(0.05)
	property number ResolveCleanupDelay = 0.3

	@Sync
	@HideFromInspector
	property number FallSpeed = 0

	@Sync
	@HideFromInspector
	property Vector3 FallStartPosition = Vector3.zero

	@Sync
	@HideFromInspector
	property number FallStartServerTime = 0

	@Sync
	@HideFromInspector
	property integer FallSequence = 0

	@Sync
	@HideFromInspector
	property Vector3 ResolvedPosition = Vector3.zero

	@Sync
	@HideFromInspector
	property integer ResolvedSequence = 0

	@HideFromInspector
	property boolean IsActive = false

	@HideFromInspector
	property boolean IsResolved = false

	@HideFromInspector
	property integer FallStartTimerId = 0

	@HideFromInspector
	property integer CleanupTimerId = 0

	@ExecSpace("ServerOnly")
	method boolean Spawn(number fallSpeed)
		if fallSpeed <= 0 then
			log_warning("[DropObstacleComponent] FallSpeed는 0보다 커야 합니다.")
			return false
		end

		if self.SyncLeadTime < 0 or self.ResolveCleanupDelay < 0 then
			log_warning("[DropObstacleComponent] 동기화 대기 시간과 정리 지연 시간은 0 이상이어야 합니다.")
			return false
		end

		local body = self.Entity.RigidbodyComponent
		if isvalid(body) == false then
			log_warning("[DropObstacleComponent] RigidbodyComponent가 없습니다.")
			return false
		end

		local trigger = self.Entity.TriggerComponent
		if isvalid(trigger) == false then
			log_warning("[DropObstacleComponent] TriggerComponent가 없습니다.")
			return false
		end

		local transform = self.Entity.TransformComponent
		if isvalid(transform) == false then
			log_warning("[DropObstacleComponent] TransformComponent가 없습니다.")
			return false
		end

		self:ClearTimers_Server()

		local startPosition = transform.WorldPosition
		local currentServerTime = _UtilLogic.ServerElapsedSeconds

		self.FallSpeed = fallSpeed
		self.FallStartPosition = startPosition
		self.FallStartServerTime = currentServerTime + self.SyncLeadTime
		self.ResolvedPosition = startPosition
		self.ResolvedSequence = 0
		self.IsResolved = false
		self.IsActive = true
		-- 동기화 시작 신호는 필요한 값을 모두 기록한 뒤 마지막에 변경합니다.
		self.FallSequence += 1

		self.Entity:SetVisible(true)
		self.Entity:SetEnable(true)
		-- 클라이언트가 시작 정보를 받을 시간을 확보할 때까지 서버 Rigidbody를 정지합니다.
		body.Enable = false
		trigger.Enable = true

		if self.SyncLeadTime <= 0 then
			self:Fall_Server()
		else
			self.FallStartTimerId = _TimerService:SetTimerOnce(function()
				self.FallStartTimerId = 0
				if isvalid(self.Entity) and self.IsActive == true and self.IsResolved == false then
					self:Fall_Server()
				end
			end, self.SyncLeadTime)

			if self.FallStartTimerId == 0 then
				-- 타이머 등록 실패 시 즉시 시작하도록 새 기준 시각을 다시 동기화합니다.
				self.FallStartServerTime = _UtilLogic.ServerElapsedSeconds
				self.FallSequence += 1
				self:Fall_Server()
			end
		end

		log("[DropObstacleComponent] 장애물 낙하 예약. speed=" .. tostring(self.FallSpeed)
			.. ", startServerTime=" .. tostring(self.FallStartServerTime)
			.. ", sequence=" .. tostring(self.FallSequence))
		return true
	end

	@ExecSpace("ServerOnly")
	method void Fall_Server()
		if self.IsActive == false then
			return
		end

		local body = self.Entity.RigidbodyComponent
		if isvalid(body) == false then
			self:Cleanup_Server()
			return
		end

		-- MapleTile의 낙하축은 -Y입니다. 전달받은 값으로 초기 속도와 최대 낙하 속도를 설정합니다.
		body.Enable = true
		body:PositionReset()
		body.FallSpeedMaxY = self.FallSpeed
		body.MoveVelocity = Vector2(0, -self.FallSpeed)
		log("[DropObstacleComponent] 서버 Rigidbody 낙하 시작. serverTime="
			.. tostring(_UtilLogic.ServerElapsedSeconds))
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		if self.FallSequence <= 0 then
			return
		end

		local transform = self.Entity.TransformComponent
		if isvalid(transform) == false then
			return
		end

		-- 서버가 충돌을 확정한 뒤에는 서버가 전달한 최종 위치를 유지합니다.
		if self.ResolvedSequence == self.FallSequence then
			transform.WorldPosition = self.ResolvedPosition
			return
		end

		if self.FallSpeed <= 0 or self.FallStartServerTime <= 0 then
			return
		end

		local elapsed = _UtilLogic.ServerElapsedSeconds - self.FallStartServerTime
		if elapsed < 0 then
			elapsed = 0
		end

		local startPosition = self.FallStartPosition
		transform.WorldPosition = Vector3(
			startPosition.x,
			startPosition.y - (self.FallSpeed * elapsed),
			startPosition.z
		)
	end

	@ExecSpace("ServerOnly")
	method void OnPlayerCollision_Server(Entity player)
		if self.IsActive == false or self.IsResolved == true then
			return
		end

		if isvalid(player) == false or isvalid(player.PlayerComponent) == false then
			return
		end

		-- 이번 단계에서는 HP와 점수를 바꾸지 않고 충돌한 플레이어의 HIT 상태만 재생합니다.
		local stateComponent = player.StateComponent
		if isvalid(stateComponent) then
			if stateComponent:ChangeState("HIT") == false then
				log_warning("[DropObstacleComponent] 플레이어 HIT 상태 변경에 실패했습니다.")
			end
		else
			log_warning("[DropObstacleComponent] 플레이어의 StateComponent가 없습니다.")
		end

		log("[DropObstacleComponent] 플레이어 충돌 처리. player=" .. player.Name)
		self:ResolveObstacle_Server()
	end

	@ExecSpace("ServerOnly")
	method void OnGroundReached_Server()
		if self.IsActive == false or self.IsResolved == true then
			return
		end

		log("[DropObstacleComponent] 바닥 도달 처리")
		self:ResolveObstacle_Server()
	end

	@ExecSpace("ServerOnly")
	method void ResolveObstacle_Server()
		if self.IsActive == false or self.IsResolved == true then
			return
		end

		local transform = self.Entity.TransformComponent
		if isvalid(transform) == false then
			self:Cleanup_Server()
			return
		end

		self.IsActive = false
		self.IsResolved = true

		local body = self.Entity.RigidbodyComponent
		if isvalid(body) then
			body.MoveVelocity = Vector2.zero
			body.Enable = false
		end

		local trigger = self.Entity.TriggerComponent
		if isvalid(trigger) then
			trigger.Enable = false
		end

		-- 최종 서버 위치를 먼저 기록하고, 완료 시퀀스를 마지막에 바꿔 클라이언트가 스냅하도록 합니다.
		self.ResolvedPosition = transform.WorldPosition
		self.ResolvedSequence = self.FallSequence

		if self.ResolveCleanupDelay <= 0 then
			self:Cleanup_Server()
			return
		end

		self.CleanupTimerId = _TimerService:SetTimerOnce(function()
			self.CleanupTimerId = 0
			if isvalid(self.Entity) then
				self:Cleanup_Server()
			end
		end, self.ResolveCleanupDelay)

		if self.CleanupTimerId == 0 then
			self:Cleanup_Server()
		end
	end

	@ExecSpace("ServerOnly")
	method void ClearTimers_Server()
		if self.FallStartTimerId ~= 0 then
			_TimerService:ClearTimer(self.FallStartTimerId)
			self.FallStartTimerId = 0
		end

		if self.CleanupTimerId ~= 0 then
			_TimerService:ClearTimer(self.CleanupTimerId)
			self.CleanupTimerId = 0
		end
	end

	@ExecSpace("ServerOnly")
	method void Cleanup_Server()
		self:ClearTimers_Server()
		self.IsActive = false
		self.IsResolved = true
		self.FallSpeed = 0

		local trigger = self.Entity.TriggerComponent
		if isvalid(trigger) then
			trigger.Enable = false
		end

		if isvalid(self.Entity) then
			self.Entity:SetEnable(false)
			self.Entity:Destroy()
		end
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleTriggerEnterEvent(TriggerEnterEvent event)
		local triggerBodyEntity = event.TriggerBodyEntity
		if isvalid(triggerBodyEntity) == false then
			return
		end

		if isvalid(triggerBodyEntity.PlayerComponent) then
			self:OnPlayerCollision_Server(triggerBodyEntity)
		end
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleFootholdCollisionEvent(FootholdCollisionEvent event)
		if event.Rigidbody ~= self.Entity.RigidbodyComponent then
			return
		end

		-- 위를 향한 바닥에 아래 방향으로 충돌했을 때만 착지로 처리합니다.
		if event.FootholdNormal.y <= 0.5 or event.ImpactDir.y >= 0 then
			return
		end

		log("FootholdId = " .. tostring(event.FootholdId))
		log("Normal = " .. tostring(event.FootholdNormal))
		log("ImpactDir = " .. tostring(event.ImpactDir))
		log("Position = " .. tostring(self.Entity.TransformComponent.WorldPosition))

		self:OnGroundReached_Server()
	end

end
