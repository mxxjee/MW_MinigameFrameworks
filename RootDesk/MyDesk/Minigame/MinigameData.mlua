@Struct
script MinigameData
	
	property string Name = ""
	
	property string ID = ""
	
	property MinigameComponent GameComponent = nil
	
	method void InitData(string _name, string _id, MinigameComponent _GameComponent)
		self.Name = _name
		self.ID = _id
		self.GameComponent = _GameComponent
		--self.GameEntity = _GameComponent.Entity
		
	end
	
end