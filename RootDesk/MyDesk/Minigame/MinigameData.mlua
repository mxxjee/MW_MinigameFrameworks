@Struct
script MinigameData

	property string Name = ""

	property string ID = ""

	property string MapName = ""

	property string Description = ""

	method void InitData(string _name, string _id, string _mapName, string Desc)
		self.Name = _name
		self.ID = _id
		self.MapName = _mapName
		self.Description = Desc
	end

end
