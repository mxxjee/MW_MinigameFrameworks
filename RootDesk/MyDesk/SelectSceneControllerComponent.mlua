@Component
script SelectSceneControllerComponent extends Component

	property Entity GameListEntity = nil

	property string SelectWidgetModelId = "model://b9a29910-7633-405a-b5c4-1d7a4c7df643"

	property number SlotSpacing = 300

	property integer CurrentIndex = 1

	property integer MaxIndex = 0

	property Vector2 TargetPosition = Vector2(0, 0)

	property table GameList = {}

	property table WidgetList = {}

	property boolean IsMoving = false

	property number MoveSpeed = 30

	property Entity DescUI = "4a999140-707a-43f8-b2fa-683c3f898c1c"

	@ExecSpace("ClientOnly")
	method void Initialize()
		
		-- 슬롯 부모를 저장한다.
		self.GameListEntity = _EntityService:GetEntityByPath("/ui/SelectGroup/GameList")
		
		if isvalid(self.GameListEntity) == false then return end
		
		-- 초기값 설정 --
		self.CurrentIndex = 1
		self.TargetPosition = Vector2(0, self.GameListEntity.UITransformComponent.anchoredPosition.y)
		self.IsMoving = false
		
		--저장된 데이터를 통해 슬롯을 생성한다--
		self:Refresh_Slots()
		
	end

	@ExecSpace("ClientOnly")
	method void Refresh_Slots()
		--슬롯 생성--
		local slotParent = _EntityService:GetEntityByPath("/ui/SelectGroup/GameList")
		if isvalid(slotParent) == false then
			return
		end
		
		self.GameList = {}
		self.WidgetList = {}
		
		local index = 0
		
		for index, gameId in pairs(_MinigameRegistry.MinigameOrders) do
			
			local gameData = _MinigameRegistry:GetMinigameData(gameId)
			-- 이후 선택된 게임을 찾기 위해 데이터도 저장
			table.insert(self.GameList, gameId)
			
			-- 0, 300, 600, 900 ... 가로 배치
			local pos = Vector2(index * self.SlotSpacing, 0)
			
			local widgetEntity = _SpawnService:SpawnByModelId(
				self.SelectWidgetModelId, "SelectWidget_" .. gameId, Vector3.zero, slotParent
			)
			
			if isvalid(widgetEntity) == false then continue end
			
			---@type SelectWidgetUIComponent
			local widgetComp =
			widgetEntity:GetComponent("script.SelectWidgetUIComponent")
			
			if isvalid(widgetComp) == false then continue end
			
			widgetComp:Initialize(gameData.Name, pos)
			
			table.insert(self.WidgetList, widgetEntity)
			
			index = index + 1
		end
		
		self.MaxIndex = #self.GameList
	end

	method void MoveToCurrentIdx()
		-- 현재 선택된 슬롯이 항상 화면 중앙 x = 0에 오도록
		-- 부모 GameList를 반대 방향으로 이동시킨다.
		local targetX = -(self.CurrentIndex - 1) * self.SlotSpacing
		
		self.TargetPosition = Vector2(targetX, self.GameListEntity.UITransformComponent.anchoredPosition.y)
		self.IsMoving = true
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		if self.IsMoving == false then return end
		
		if isvalid(self.GameListEntity) == false then return end
		
		
		local uiTransform = self.GameListEntity.UITransformComponent
		local currentPosition = uiTransform.anchoredPosition
		local nextPosition = Vector2.Lerp(currentPosition, self.TargetPosition, delta * self.MoveSpeed)
		uiTransform.anchoredPosition = nextPosition
		
		-- Lerp는 정확히 목표값에 닿지 않을 수 있으므로
		-- 충분히 가까워지면 정확한 위치로 맞춘다.
		if Vector2.Distance(nextPosition, self.TargetPosition) < 0.5 then
			self:OnReach()
			
			
		end
	end

	method void OnReach()
		local uiTransform = self.GameListEntity.UITransformComponent
		uiTransform.anchoredPosition = self.TargetPosition
		self.IsMoving = false
		
		local gameId=self.GameList[self.CurrentIndex]
		log(gameId)
	end

	@EventSender("Service", "InputService")
	handler HandleKeyDownEvent(KeyDownEvent event)
		--------------- Native Event Sender Info ----------------
		-- Sender: InputService
		-- Space: Client
		---------------------------------------------------------
		
		-- Parameters
		-- local inputValue = event.inputValue
		-- local key = event.key
		---------------------------------------------------------
		local key = event.key
		
		
		-- 왼쪽
		if key == KeyboardKey.LeftArrow then
			
			if self.CurrentIndex <= 1 then return end
			
			self.CurrentIndex = self.CurrentIndex - 1
			
			self:MoveToCurrentIdx()
			
			-- 오른쪽
		elseif key == KeyboardKey.RightArrow then
			
			if self.CurrentIndex >= self.MaxIndex then return end
			
			self.CurrentIndex = self.CurrentIndex + 1
			
			self:MoveToCurrentIdx()
		end
	end

end