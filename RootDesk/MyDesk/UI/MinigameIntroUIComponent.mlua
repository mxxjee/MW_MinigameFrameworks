@Component
script MinigameIntroUIComponent extends Component

	property Entity LogoUI = nil

	property Entity CountdownUI = nil

	property number LogoHoldTime = 2

	property number LogoScaleDuration = 0.35

	property number LogoFadeDuration = 1

	property number LogoStartScale = 0.65

	property string CountdownStartRUID = ""

	property number StartImageDuration = 0.6

	property number StartImageStartScale = 1.3

	property number StartImageScaleDuration = 0.2

	property boolean IsCountdownPlaying = false

	property boolean IsStartImagePlaying = false

	property boolean IsFinishImagePlaying = false

	property boolean IsFinishEventConnected = false

	property integer LogoTimerId = 0

	property integer LogoFadeTimerId = 0

	property integer CountdownEndTimerId = 0

	property Entity StartUI = nil

	property Entity FinishUI = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- GameIntroGroup은 기본 비활성 상태이며 BeginIntro()가 Reset 후 연출을 시작합니다.
		-- 첫 활성화 직후 OnBeginPlay가 늦게 호출되어 PlayLogo 결과를 다시 끄지 않도록
		-- 여기에서는 자식 UI의 활성 상태를 변경하지 않습니다.
		if isvalid(self.CountdownUI) then
			-- 단일 3 → 2 → 1 애니메이션의 실제 재생 완료 시점을 받습니다.
			self.CountdownUI:ConnectEvent(
				SpriteGUIAnimPlayerEndEvent,
				self.OnCountdownAnimationEnd
			)
		end

		if isvalid(self.StartUI) then
			self.StartUI:ConnectEvent(
				SpriteGUIAnimPlayerEndEvent,
				self.OnStartAnimationEnd
			)
		end

		self:InitializeFinishUI()
	end

	@ExecSpace("ClientOnly")
	method boolean InitializeFinishUI()
		if isvalid(self.FinishUI) == false then
			self.FinishUI = _EntityService:GetEntityByPath("/ui/GameIntroGroup/Finish")
			self.IsFinishEventConnected = false
		end

		if isvalid(self.FinishUI) == false then
			return false
		end

		if self.IsFinishEventConnected == false then
			self.FinishUI:ConnectEvent(
				SpriteGUIAnimPlayerEndEvent,
				self.OnFinishAnimationEnd
			)
			self.IsFinishEventConnected = true
		end

		self.FinishUI.Enable = false
		self.FinishUI.Visible = false
		return true
	end

	@ExecSpace("ClientOnly")
	method void PlayLogo(string logoRUID)
		-- 이전 인트로에서 남아 있을 수 있는 Timer를 먼저 제거합니다.
		self:ClearTimers()
		self:HideFinish()
		
		if isvalid(self.LogoUI) == false then
			return
		end
		
		local renderer = self.LogoUI.SpriteGUIRendererComponent
		local uiTransform = self.LogoUI.UITransformComponent
		
		if isvalid(renderer) == false or isvalid(uiTransform) == false then
			return
		end
		
		-- 로고를 출력하는 동안 카운트다운 UI는 숨깁니다.
		if isvalid(self.CountdownUI) then
			self.CountdownUI.Enable = false
			self.CountdownUI.Visible = false
			
			self.StartUI.Enable=false
			self.StartUI.Visible=false
		end
		
		-- Registry에 로고가 등록된 경우에만 교체합니다.
		-- 빈 값이면 UI Editor에 설정된 기본 ImageRUID를 유지합니다.
		if logoRUID ~= "" then
			renderer.ImageRUID = logoRUID
		end
		
		-- 이전 Fade Out의 Alpha 값이 남아 있을 수 있으므로 다시 완전히 보이도록 초기화합니다.
		renderer:SetAlpha(1)
		
		-- 로고를 작은 크기에서 시작하도록 설정합니다.
		uiTransform.UIScale = Vector3(
			self.LogoStartScale,
			self.LogoStartScale,
			1
		)
		
		self.LogoUI.Visible = true
		self.LogoUI.Enable = true
		
		-- 로고가 작은 상태에서 원래 크기로 확대되며 등장하도록 연출합니다.
		_TweenLogic:PlayTween(
			Vector3(
				self.LogoStartScale,
				self.LogoStartScale,
				1
			),
			Vector3(1, 1, 1),
			self.LogoScaleDuration,
			EaseType.BackEaseOut,
			function(scale)
				if isvalid(self.LogoUI) == false then
					return
				end
				
				self.LogoUI.UITransformComponent.UIScale = scale
			end
		)
		
		-- 로고를 일정 시간 동안 보여준 뒤 Fade Out을 시작합니다.
		self.LogoTimerId = _TimerService:SetTimerOnce(function()
			self:FadeOutLogo()
		end, self.LogoHoldTime)
	end

	@ExecSpace("ClientOnly")
	method void FadeOutLogo()
		if isvalid(self.LogoUI) == false then
			return
		end
		
		local renderer = self.LogoUI.SpriteGUIRendererComponent
		
		if isvalid(renderer) == false then
			return
		end
		
		-- Alpha 값을 1에서 0으로 줄여 로고를 자연스럽게 사라지게 합니다.
		_TweenLogic:PlayTween(
			1,
			0,
			self.LogoFadeDuration,
			EaseType.QuadEaseOut,
			function(alpha)
				if isvalid(renderer) == false then
					return
				end
				
				renderer:SetAlpha(alpha)
			end
		)
		
		-- Fade Out이 끝난 뒤 로고 UI를 숨기고 로고 종료 이벤트를 발생시킵니다.
		self.LogoFadeTimerId = _TimerService:SetTimerOnce(function()
			if isvalid(self.LogoUI) then
				self.LogoUI.Enable = false
				self.LogoUI.Visible = false
			end
			
			-- Manager는 이 이벤트를 받은 뒤 카운트다운을 시작합니다.
			self.Entity:SendEvent(MinigameLogoEndEvent())
		end, self.LogoFadeDuration)
	end

	@ExecSpace("ClientOnly")
	method void PlayCountdown()
		-- 이전 카운트다운에서 남아 있을 수 있는 상태와 Timer를 제거합니다.
		self:ClearCountdownTimers()
		
		if isvalid(self.CountdownUI) == false then
			return
		end
		
		local renderer = self.CountdownUI.SpriteGUIRendererComponent
		
		if isvalid(renderer) == false then
			return
		end
		
		-- 카운트다운이 시작될 때 로고 UI는 확실하게 숨깁니다.
		if isvalid(self.LogoUI) then
			self.LogoUI.Enable = false
			self.LogoUI.Visible = false
		end
		
		-- 같은 인트로 UI를 다시 사용해도 애니메이션이 첫 프레임부터 재생되도록
		-- Entity를 끈 상태에서 단발 재생 설정을 적용한 뒤 다시 켭니다.
		self.CountdownUI.Enable = false
		renderer.AnimClipPlayType = SpriteAnimClipPlayType.Onetime
		renderer.StartFrameIndex = 0
		renderer:SetAlpha(1)
		
		self.IsCountdownPlaying = true
		self.CountdownUI.Visible = true
		self.CountdownUI.Enable = true
	end

	@ExecSpace("ClientOnly")
	method void OnCountdownAnimationEnd(SpriteGUIAnimPlayerEndEvent event)
		-- START 이미지로 교체한 뒤 발생할 수 있는 다른 종료 이벤트는 무시합니다.
		if self.IsCountdownPlaying == false then
			return
		end
		
		-- 연결된 CountdownUI의 애니메이션 종료 이벤트인지 한 번 더 확인합니다.
		if event.Entity ~= self.CountdownUI then
			return
		end
		
		self.IsCountdownPlaying = false
		
		-- 단일 3 → 2 → 1 애니메이션이 실제로 끝난 시점에 START 이미지를 출력합니다.
		self:ShowStartImage()
	end

	@ExecSpace("ClientOnly")
	method void ShowStartImage()
		if isvalid(self.StartUI) == false then
			return
		end
		
		local renderer = self.StartUI.SpriteGUIRendererComponent
		
		
		if isvalid(renderer) == false then
			return
		end
		
		-- Start 이미지가 시작될 때 Countdown UI는 확실하게 숨깁니다.
		if isvalid(self.CountdownUI) then
			self.CountdownUI.Enable = false
			self.CountdownUI.Visible = false
		end
		
		-- 같은 인트로 UI를 다시 사용해도 애니메이션이 첫 프레임부터 재생되도록
		-- Entity를 끈 상태에서 단발 재생 설정을 적용한 뒤 다시 켭니다.
		self.StartUI.Enable = false
		renderer.AnimClipPlayType = SpriteAnimClipPlayType.Onetime
		renderer.StartFrameIndex = 0
		renderer:SetAlpha(1)
		
		self.IsStartImagePlaying = true
		self.StartUI.Visible = true
		self.StartUI.Enable = true
		
	end

	@ExecSpace("ClientOnly")
	method void OnStartAnimationEnd(SpriteGUIAnimPlayerEndEvent event)
		-- START 이미지로 교체한 뒤 발생할 수 있는 다른 종료 이벤트는 무시합니다.
		if self.IsStartImagePlaying == false then
			return
		end
		
		-- 연결된 StartUI의 애니메이션 종료 이벤트인지 한 번 더 확인합니다.
		if event.Entity ~= self.StartUI then
			return
		end
		
		self.IsStartImagePlaying = false
		self.Entity:SendEvent(MinigameCountdownEndEvent())
		
		self.StartUI.Visible = false
		self.StartUI.Enable = false
	end

	@ExecSpace("ClientOnly")
	method boolean PlayFinish()
		if self:InitializeFinishUI() == false then
			log_warning("[MinigameIntroUIComponent] Finish UI를 찾을 수 없습니다.")
			return false
		end

		if isvalid(self.LogoUI) then
			self.LogoUI.Enable = false
			self.LogoUI.Visible = false
		end

		if isvalid(self.CountdownUI) then
			self.CountdownUI.Enable = false
			self.CountdownUI.Visible = false
		end

		if isvalid(self.StartUI) then
			self.StartUI.Enable = false
			self.StartUI.Visible = false
		end

		local renderer = self.FinishUI.SpriteGUIRendererComponent
		if isvalid(renderer) == false then
			return false
		end

		self.FinishUI.Enable = false
		renderer.AnimClipPlayType = SpriteAnimClipPlayType.Onetime
		renderer.StartFrameIndex = 0
		renderer:SetAlpha(1)

		self.IsFinishImagePlaying = true
		self.FinishUI.Visible = true
		self.FinishUI.Enable = true
		return true
	end

	@ExecSpace("ClientOnly")
	method void OnFinishAnimationEnd(SpriteGUIAnimPlayerEndEvent event)
		if self.IsFinishImagePlaying == false then
			return
		end

		if event.Entity ~= self.FinishUI then
			return
		end

		self:HideFinish()
		_MinigameEndLogic:NotifyFinishAnimationEnd()
	end

	@ExecSpace("ClientOnly")
	method void HideFinish()
		self.IsFinishImagePlaying = false

		if isvalid(self.FinishUI) then
			self.FinishUI.Visible = false
			self.FinishUI.Enable = false
		end
	end

	@ExecSpace("ClientOnly")
	method void ClearCountdownTimers()
		-- 애니메이션 종료 이벤트가 늦게 도착해도 다음 단계로 넘어가지 않도록 막습니다.
		self.IsCountdownPlaying = false
		
		-- START 이미지 종료 Timer가 동작 중이라면 제거합니다.
		if self.CountdownEndTimerId ~= 0 then
			_TimerService:ClearTimer(self.CountdownEndTimerId)
			self.CountdownEndTimerId = 0
		end
	end

	@ExecSpace("ClientOnly")
	method void ClearTimers()
		-- 로고 유지 Timer가 동작 중이라면 제거합니다.
		if self.LogoTimerId ~= 0 then
			_TimerService:ClearTimer(self.LogoTimerId)
			self.LogoTimerId = 0
		end
		
		-- 로고 Fade Out Timer가 동작 중이라면 제거합니다.
		if self.LogoFadeTimerId ~= 0 then
			_TimerService:ClearTimer(self.LogoFadeTimerId)
			self.LogoFadeTimerId = 0
		end
		
		-- 카운트다운에서 사용하는 Timer도 함께 제거합니다.
		self:ClearCountdownTimers()
	end

	@ExecSpace("ClientOnly")
	method void Reset()
		-- 진행 중인 모든 인트로 Timer를 종료합니다.
		self:ClearTimers()
		
		-- 인트로 UI를 초기 상태로 되돌립니다.
		if isvalid(self.LogoUI) then
			self.LogoUI.Enable = false
			self.LogoUI.Visible = false
		end
		
		if isvalid(self.CountdownUI) then
			self.CountdownUI.Enable = false
			self.CountdownUI.Visible = false
		end

		if isvalid(self.StartUI) then
			self.StartUI.Enable = false
			self.StartUI.Visible = false
		end

		self:HideFinish()
		
		self.IsCountdownPlaying = false
		self.IsStartImagePlaying=false
	end

end
