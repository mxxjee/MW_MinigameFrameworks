@Component
script MinigameIntroUIComponent extends Component

	property Entity LogoUI = nil

	property Entity CountdownUI = nil

	property number LogoHoldTime = 2

	property number LogoScaleDuration = 0.35

	property number LogoFadeDuration = 0.3

	property number LogoStartScale = 0.65

	property string Countdown3RUID = ""

	property string Countdown2RUID = ""

	property string Countdown1RUID = ""

	property string CountdownStartRUID = ""

	property number CountdownInterval = 1

	property number StartImageDuration = 0.6

	property number CountdownStartScale = 1.3

	property number CountdownScaleDuration = 0.2

	property integer CountdownValue = 0

	property integer LogoTimerId = 0

	property integer LogoFadeTimerId = 0

	property integer CountdownTimerId = 0

	property integer CountdownEndTimerId = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 인트로 시작 전에는 로고와 카운트다운 UI를 모두 숨겨둡니다.
		if isvalid(self.LogoUI) then
			self.LogoUI.Enable = false
		end
		
		if isvalid(self.CountdownUI) then
			self.CountdownUI.Enable = false
		end
	end

	@ExecSpace("ClientOnly")
	method void PlayLogo(string logoRUID)
		-- 이전 인트로에서 남아 있을 수 있는 Timer를 먼저 제거합니다.
		self:ClearTimers()
		
		if isvalid(self.LogoUI) == false then
			return
		end
		
		local renderer = self.LogoUI.SpriteGUIRendererComponent
		local uiTransform = self.LogoUI.UITransformComponent
		
		if isvalid(renderer) == false or isvalid(uiTransform) == false then
			return
		end
		
		-- 로고를 출력하는 동안 카운트다운 UI는 숨깁니다.
		if isvalid(self.CountdownUI) then
			self.CountdownUI.Enable = false
		end
		
		-- Registry에서 전달받은 현재 미니게임의 로고 이미지를 적용합니다.
		renderer.ImageRUID = logoRUID
		
		-- 이전 Fade Out의 Alpha 값이 남아 있을 수 있으므로 다시 완전히 보이도록 초기화합니다.
		renderer:SetAlpha(1)
		
		-- 로고를 작은 크기에서 시작하도록 설정합니다.
		uiTransform.UIScale = Vector3(
			self.LogoStartScale,
			self.LogoStartScale,
			1
		)
		
		self.LogoUI.Enable = true
		
		-- 로고가 작은 상태에서 원래 크기로 확대되며 등장하도록 연출합니다.
		_TweenLogic:PlayTween(
			Vector3(
				self.LogoStartScale,
				self.LogoStartScale,
				1
			),
			Vector3(1, 1, 1),
			self.LogoScaleDuration,
			EaseType.BackEaseOut,
			function(scale)
				if isvalid(self.LogoUI) == false then
					return
				end
				
				self.LogoUI.UITransformComponent.UIScale = scale
			end
		)
		
		-- 로고를 일정 시간 동안 보여준 뒤 Fade Out을 시작합니다.
		self.LogoTimerId = _TimerService:SetTimerOnce(function()
			self:FadeOutLogo()
		end, self.LogoHoldTime)
	end

	@ExecSpace("ClientOnly")
	method void FadeOutLogo()
		if isvalid(self.LogoUI) == false then
			return
		end
		
		local renderer = self.LogoUI.SpriteGUIRendererComponent
		
		if isvalid(renderer) == false then
			return
		end
		
		-- Alpha 값을 1에서 0으로 줄여 로고를 자연스럽게 사라지게 합니다.
		_TweenLogic:PlayTween(
			1,
			0,
			self.LogoFadeDuration,
			EaseType.QuadEaseOut,
			function(alpha)
				if isvalid(renderer) == false then
					return
				end
				
				renderer:SetAlpha(alpha)
			end
		)
		
		-- Fade Out이 끝난 뒤 로고 UI를 숨기고 로고 종료 이벤트를 발생시킵니다.
		self.LogoFadeTimerId = _TimerService:SetTimerOnce(function()
			if isvalid(self.LogoUI) then
				self.LogoUI.Enable = false
			end
			
			-- Manager는 이 이벤트를 받은 뒤 카운트다운을 시작합니다.
			self.Entity:SendEvent(MinigameLogoEndEvent())
		end, self.LogoFadeDuration)
	end

	@ExecSpace("ClientOnly")
	method void PlayCountdown()
		-- 이전 카운트다운에서 남아 있을 수 있는 Timer를 제거합니다.
		self:ClearCountdownTimers()
		
		if isvalid(self.CountdownUI) == false then
			return
		end
		
		-- 카운트다운이 시작될 때 로고 UI는 확실하게 숨깁니다.
		if isvalid(self.LogoUI) then
			self.LogoUI.Enable = false
		end
		
		-- 카운트다운은 3부터 시작합니다.
		self.CountdownValue = 3
		
		self.CountdownUI.Enable = true
		
		-- 현재 CountdownValue에 맞는 이미지를 출력합니다.
		self:ShowCountdownImage()
	end

	@ExecSpace("ClientOnly")
	method void ShowCountdownImage()
		if isvalid(self.CountdownUI) == false then
			return
		end
		
		local renderer = self.CountdownUI.SpriteGUIRendererComponent
		local uiTransform = self.CountdownUI.UITransformComponent
		
		if isvalid(renderer) == false or isvalid(uiTransform) == false then
			return
		end
		
		-- 현재 카운트다운 값에 해당하는 이미지로 교체합니다.
		if self.CountdownValue == 3 then
			renderer.ImageRUID = self.Countdown3RUID
			
		elseif self.CountdownValue == 2 then
			renderer.ImageRUID = self.Countdown2RUID
			
		elseif self.CountdownValue == 1 then
			renderer.ImageRUID = self.Countdown1RUID
		end
		
		renderer:SetAlpha(1)
		
		-- 카운트다운 이미지를 크게 설정한 뒤 원래 크기로 줄어들도록 합니다.
		uiTransform.UIScale = Vector3(
			self.CountdownStartScale,
			self.CountdownStartScale,
			1
		)
		
		_TweenLogic:PlayTween(
			Vector3(
				self.CountdownStartScale,
				self.CountdownStartScale,
				1
			),
			Vector3(1, 1, 1),
			self.CountdownScaleDuration,
			EaseType.BackEaseOut,
			function(scale)
				if isvalid(self.CountdownUI) == false then
					return
				end
				
				self.CountdownUI.UITransformComponent.UIScale = scale
			end
		)
		
		-- 현재 숫자를 일정 시간 보여준 뒤 다음 카운트다운으로 넘어갑니다.
		self.CountdownTimerId = _TimerService:SetTimerOnce(function()
			self:NextCountdown()
		end, self.CountdownInterval)
	end

	@ExecSpace("ClientOnly")
	method void NextCountdown()
		-- 현재 카운트다운 숫자를 하나 감소시킵니다.
		self.CountdownValue = self.CountdownValue - 1
		
		-- 3 → 2 → 1 순서로 다음 이미지를 출력합니다.
		if self.CountdownValue > 0 then
			self:ShowCountdownImage()
			return
		end
		
		-- 1까지 모두 출력했다면 마지막으로 START 이미지를 출력합니다.
		self:ShowStartImage()
	end

	@ExecSpace("ClientOnly")
	method void ShowStartImage()
		if isvalid(self.CountdownUI) == false then
			return
		end
		
		local renderer = self.CountdownUI.SpriteGUIRendererComponent
		local uiTransform = self.CountdownUI.UITransformComponent
		
		if isvalid(renderer) == false or isvalid(uiTransform) == false then
			return
		end
		
		-- 카운트다운이 끝난 뒤 START 이미지로 교체합니다.
		renderer.ImageRUID = self.CountdownStartRUID
		renderer:SetAlpha(1)
		
		-- START 이미지도 카운트다운과 동일하게 확대된 상태에서 등장하도록 합니다.
		uiTransform.UIScale = Vector3(
			self.CountdownStartScale,
			self.CountdownStartScale,
			1
		)
		
		_TweenLogic:PlayTween(
			Vector3(
				self.CountdownStartScale,
				self.CountdownStartScale,
				1
			),
			Vector3(1, 1, 1),
			self.CountdownScaleDuration,
			EaseType.BackEaseOut,
			function(scale)
				if isvalid(self.CountdownUI) == false then
					return
				end
				
				self.CountdownUI.UITransformComponent.UIScale = scale
			end
		)
		
		-- START 이미지 출력이 끝나면 UI를 숨기고 카운트다운 종료 이벤트를 발생시킵니다.
		self.CountdownEndTimerId = _TimerService:SetTimerOnce(function()
			if isvalid(self.CountdownUI) then
				self.CountdownUI.Enable = false
			end
			
			-- Manager는 이 이벤트를 받은 뒤 실제 미니게임을 시작합니다.
			self.Entity:SendEvent(MinigameCountdownEndEvent())
		end, self.StartImageDuration)
	end

	@ExecSpace("ClientOnly")
	method void ClearCountdownTimers()
		-- 숫자 카운트다운 Timer가 동작 중이라면 제거합니다.
		if self.CountdownTimerId ~= 0 then
			_TimerService:ClearTimer(self.CountdownTimerId)
			self.CountdownTimerId = 0
		end
		
		-- START 이미지 종료 Timer가 동작 중이라면 제거합니다.
		if self.CountdownEndTimerId ~= 0 then
			_TimerService:ClearTimer(self.CountdownEndTimerId)
			self.CountdownEndTimerId = 0
		end
	end

	@ExecSpace("ClientOnly")
	method void ClearTimers()
		-- 로고 유지 Timer가 동작 중이라면 제거합니다.
		if self.LogoTimerId ~= 0 then
			_TimerService:ClearTimer(self.LogoTimerId)
			self.LogoTimerId = 0
		end
		
		-- 로고 Fade Out Timer가 동작 중이라면 제거합니다.
		if self.LogoFadeTimerId ~= 0 then
			_TimerService:ClearTimer(self.LogoFadeTimerId)
			self.LogoFadeTimerId = 0
		end
		
		-- 카운트다운에서 사용하는 Timer도 함께 제거합니다.
		self:ClearCountdownTimers()
	end

	@ExecSpace("ClientOnly")
	method void Reset()
		-- 진행 중인 모든 인트로 Timer를 종료합니다.
		self:ClearTimers()
		
		-- 인트로 UI를 초기 상태로 되돌립니다.
		if isvalid(self.LogoUI) then
			self.LogoUI.Enable = false
		end
		
		if isvalid(self.CountdownUI) then
			self.CountdownUI.Enable = false
		end
		
		self.CountdownValue = 0
	end

end