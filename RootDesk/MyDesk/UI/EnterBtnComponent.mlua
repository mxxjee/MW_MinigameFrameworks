@Component
script EnterBtnComponent extends Component

	property integer Mode = 0

	property boolean bSelected = false

	@EventSender("Self")
	handler HandleButtonClickEvent(ButtonClickEvent event)
		--------------- Native Event Sender Info ----------------
		-- Sender: ButtonComponent
		-- Space: Client
		---------------------------------------------------------
		
		-- Parameters
		-- local Entity = event.Entity
		---------------------------------------------------------
		--클라이언트 영역의 변수 업데이트--
		if self.Mode==_GameEnum.PlayMode.SINGLE then
		_GameLogic:SetPlayMode("SINGLE")
		
		local player = _UserService.LocalPlayer
		_TeleportService:TeleportToMapPosition(
		    player,
		    Vector3(0, 0, 0),
		    "SelectScene"
		)
		
		else
			--서버와 매칭연결시도..
			_GameLogic:SetPlayMode("MULTI")
		end
		
		self.bSelected=true
		
	end

	@EventSender("Service", "ScreenTransitionService")
	handler HandleFadeOutEndEvent(FadeOutEndEvent event)
		--------------- Native Event Sender Info ----------------
		-- Sender: ScreenTransitionService
		-- Space: Client
		---------------------------------------------------------
		
		--2번 호출막기--
		if (self.bSelected==false) then return end
		
		_GameHelper:EnableUIGroup("/ui/LobbyGroup",false)
		_GameHelper:EnableUIGroup("/ui/SelectButtonGroup",false)
		self.bSelected=false
		
	end

end